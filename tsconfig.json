{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "frontend/src/**/*.ts",
    "tests/frontend/**/*.ts"
  ]
}
