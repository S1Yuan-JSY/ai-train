DEEPSEEK_API_KEY=replace_with_new_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
APP_ACCESS_TOKEN=replace_with_long_random_token
PORT=8787
MEMORY_DB=backend/data/memory.sqlite3
LANGSMITH_TRACING=false
COOKIE_SECURE=false
POSTGRES_PASSWORD=replace_with_random_database_password
# Fill to enable Agent Store and Saver; run python -m backend.setup_memory first.
POSTGRES_URI=
# Optional embedding service; leave empty for namespace/key memory.
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_DIMS=

# 可选：未设置POSTGRES_URI时，助手默认保存在backend/data/agent.sqlite3
# AGENT_MEMORY_DB=backend/data/agent.sqlite3
